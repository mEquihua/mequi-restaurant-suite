{
  "name": "restaurant-suite",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "dev": "pnpm --parallel --stream -r --if-present dev",
    "lint": "eslint . --max-warnings=0 --ignore-pattern 'services/api/lint-fixtures/**'",
    "typecheck": "tsc -b",
    "test": "pnpm -r --if-present test",
    "contracts:generate": "pnpm --filter @restaurant-suite/contracts generate",
    "contracts:check": "pnpm --filter @restaurant-suite/contracts check:generated"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "eslint": "^9.36.0",
    "eslint-plugin-boundaries": "^5.1.0",
    "eslint-import-resolver-typescript": "^3.10.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.0",
    "vite": "^7.1.7",
    "vitest": "^3.2.4",
    "workbox-build": "^7.3.0"
  }
}
