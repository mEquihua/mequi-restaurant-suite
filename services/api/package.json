{
  "name": "@restaurant-suite/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "migrate": "node-pg-migrate up --migrations-dir migrations --migration-file-language js",
    "seed:identity": "tsx src/modules/identity/seed.ts",
    "test": "vitest run && node ../../packages/config/scripts/verify-api-boundaries.mjs",
    "test:integration": "pnpm migrate && DATABASE_URL=\"${DATABASE_URL:?DATABASE_URL is required}\" pnpm test",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@fastify/websocket": "^11.3.0",
    "@restaurant-suite/contracts": "workspace:*",
    "@restaurant-suite/domain": "workspace:*",
    "argon2": "^0.45.1",
    "fastify": "^5.6.0",
    "ioredis": "^6.0.0",
    "kysely": "^0.29.6",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/pg": "^8.15.6",
    "@types/ws": "^8.18.1",
    "node-pg-migrate": "^9.0.0",
    "tsx": "^4.20.5",
    "ws": "^8.21.3"
  }
}
